---
// Kai acompaña la lectura en computador: aparece abajo a la izquierda (en el carril libre)
// cuando termina la portada y se va antes del contacto, donde ya está el Kai grande.
// Sin JS: su entrada y salida van con la misma línea de tiempo --flujo que usa el cubo.
// Con 3D, aquí vive el mismo Kai de la portada: mira el contenido que se está leyendo y al cursor.
import KaiVivo from './KaiVivo.astro';
---

<a class="acompanante" href="#contacto">
  <div class="cuerpo">
    <span class="globo">¿Hablamos?</span>
    <KaiVivo lugar="acompanante" ancho={104} alt="Kai: ir a contacto" />
  </div>
</a>

<style>
  /* Base (Firefox, celular y «reducir movimiento»): no se muestra */
  .acompanante {
    display: none;
  }

  @supports (animation-timeline: view()) and (timeline-scope: none) {
    @media (prefers-reduced-motion: no-preference) and (width >= 56.25rem) {
      .acompanante {
        position: fixed;
        left: max(24px, calc(50vw - 680px));
        bottom: 24px;
        z-index: 15;
        display: flex;
        align-items: flex-end;
        flex-direction: column;
        gap: 4px;
        text-decoration: none;
        animation: acompanante-aparece linear both;
        animation-timeline: --flujo;
        animation-range: cover 0% cover 100%;
      }
      /*
        Mientras «Tu día» pasa por abajo, Kai taparía la hora de sus filas (empiezan en el mismo borde).
        Aparece cuando el final de «Tu día» ya subió unos 140 px: --dia es la línea de tiempo de esa sección.
      */
      .cuerpo {
        display: flex;
        align-items: flex-end;
        flex-direction: column;
        gap: 4px;
        animation: acompanante-tras-dia linear both;
        animation-timeline: --dia;
        animation-range: exit 10% exit 22%;
      }
      /* El cuadro de Kai deja aire abajo (sombra) y a los lados (giro de la cabeza): -14 px lo compensa */
      .acompanante :global(.kai-vivo) {
        --kai-lado: 104px;
        margin: -14px 0 -10px -14px;
        transition:
          scale 0.3s var(--ease-kairo),
          opacity 0.3s;
      }
      /* Si Kai ya está en el contacto, este se aparta para que no haya dos */
      :global(html[data-kai-en='contacto']) .acompanante :global(.kai-vivo) {
        opacity: 0;
      }
      /* El globo solo aparece al pasar el mouse o con el teclado: no tapa nada mientras se lee */
      .globo {
        align-self: flex-start;
        padding: 6px 12px;
        border-radius: 999px 999px 999px 4px;
        background: var(--color-negro);
        color: var(--color-white);
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        opacity: 0;
        translate: 0 6px;
        transition:
          opacity 0.25s,
          translate 0.25s var(--ease-kairo);
      }
      .acompanante:hover .globo,
      .acompanante:focus-visible .globo {
        opacity: 1;
        translate: 0 0;
      }
      .acompanante:hover :global(.kai-vivo) {
        scale: 1.06;
      }
    }
  }

  @keyframes acompanante-tras-dia {
    from { opacity: 0; translate: 0 24px; visibility: hidden; }
    to { opacity: 1; translate: 0 0; visibility: visible; }
  }

  /* --flujo va de «Tu día» al contacto: entra al comienzo y se apaga al final */
  @keyframes acompanante-aparece {
    0%, 4% { opacity: 0; transform: translateY(24px); visibility: hidden; }
    9%, 84% { opacity: 1; transform: none; visibility: visible; }
    89%, 100% { opacity: 0; transform: translateY(24px); visibility: hidden; }
  }
</style>
