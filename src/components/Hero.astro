---
// Portada «bloques-cursor». Las posiciones de los 27 bloques salen de src/data/bloques.ts.
import { bloques, pasos } from '../data/bloques';
import KaiVivo from './KaiVivo.astro';

const caras = ['frente', 'atras', 'arriba', 'abajo', 'der', 'izq'];
---

<section id="inicio" class="portada">
  <div class="escena-fija">
    <div class="contenedor marco">

      <div class="texto-hero">
        <h1 class="titulo h1">
          Software a la medida que <span class="text-violeta">trabaja por ti.</span>
        </h1>
        <p class="sub">Páginas web, agentes de IA y automatizaciones hechas para cómo opera tu negocio.</p>
        <div class="cta-fila">
          <a class="btn btn-hero" href="#servicios" data-kai-mira>Conoce más <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="escena">
        <div class="grupo" aria-hidden="true">
          <div class="camara">
            <!-- Sombra del cubo en el piso (solo mientras está armado junto a Kai) -->
            <div class="suelo"></div>
            {
              bloques.map((b) => (
                <div class:list={['bloque', { 'con-mini': b.conMini }]} style={b.estilo}>
                  {caras.map((cara) => (
                    <i class={cara} />
                  ))}
                </div>
              ))
            }
          </div>
        </div>
        <!-- Kai parado junto al cubo, en el mismo piso (celular, tablet y computador).
             Fuera de .grupo para no mezclarse con las caras 3D del cubo -->
        <div class="kai-ancla" aria-hidden="true">
          <KaiVivo lugar="portada" ancho={270} tamanos="(min-width: 1500px) 425px, (min-width: 900px) 360px, 270px" prioridad />
        </div>
        <ul class="etiquetas">
          {
            pasos.map((p) => (
              <li class="etiqueta" style={`--lx:${p.x}px;--ly:${p.y}px;--mlx:${p.xMovil}px;--mly:${p.yMovil}px`}>
                <strong>{p.titulo}</strong>
                <span>{p.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="frase">
        <h2 class="titulo">Tecnología que se adapta <span class="text-violeta">a tu negocio.</span></h2>
        <p>Automatizamos lo repetitivo para que tu equipo se enfoque en lo importante.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     1. VERSIÓN ESTÁTICA (base)
     Firefox, navegadores sin scroll-driven animations y «reducir movimiento»:
     título, el cubo de bloques quieto, los tres pasos en lista y la frase.
     ========================================================================= */
  .portada {
    --pad: 24px;
    position: relative;
    background: linear-gradient(180deg, var(--color-lav) 0%, var(--color-lav-2) 60%, var(--color-lav-3) 100%);
  }
  .escena-fija {
    padding: 40px 0 96px;
  }

  .texto-hero {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .h1 {
    font-size: clamp(36px, 10vw, 52px);
    line-height: 1;
  }
  .sub {
    margin: 0;
    font-size: 18px;
    color: var(--color-tinta-2);
    max-width: 36ch;
  }
  .cta-fila {
    display: flex;
    align-items: center;
  }
  .btn-hero {
    min-height: 56px;
    padding: 0 30px;
    font-size: 17px;
  }

  /*
    Kai y el cubo: una sola composición. Kai se para junto a la cara derecha del cubo, en el mismo piso,
    un poco más alto que él (≈ 1,15 veces; su cabeza mide lo que el cubo) y con la cabeza tapando apenas la esquina, como si se apoyara.
    Las medidas salen de proyectar las esquinas del cubo con su giro (rotateX -24°, rotateY -35°):
    --kx/--ky/--kz es el punto del piso donde van los pies de Kai, relativo al centro del cubo.
    --par-x/--par-y corren el cubo para que el conjunto (no solo el cubo) quede centrado.
    Versión estática (sin animación con scroll o con «reducir movimiento»): cubo a 60 % y Kai al lado.
  */
  .escena {
    position: relative;
    margin-top: 40px;
    perspective: 1500px;
    --grupo-alto: 270px;
    --par-x: -64px;
    --par-y: 20px;
    --kx: 138.3px;
    --ky: 56.8px;
    --kz: -58.7px;
    --kai-lado: 242px;
  }
  .grupo {
    position: relative;
    height: var(--grupo-alto);
  }
  .camara {
    position: absolute;
    left: calc(50% + var(--par-x));
    top: calc(50% + var(--par-y));
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(-35deg);
    scale: 0.6;
  }
  .kai-ancla {
    position: absolute;
    left: calc(50% + var(--par-x));
    top: calc(var(--grupo-alto) / 2 + var(--par-y));
    width: 0;
    height: 0;
    pointer-events: none;
    transform: translate3d(var(--kx), var(--ky), var(--kz));
  }
  /* Los pies de Kai están al 89,9 % del alto de su cuadro (src/scripts/kai/forma.ts) */
  .kai-ancla :global(.kai-vivo) {
    position: absolute;
    left: calc(var(--kai-lado) / -2);
    top: calc(var(--kai-lado) * -0.899);
  }
  /*
    Sombra del cubo: un plano acostado en el piso (bajo la cara de abajo, a 93 px del centro), corrido
    un poco a la derecha porque la luz viene de arriba a la izquierda, como en Kai. Sombra neutra.
  */
  .suelo {
    position: absolute;
    left: -170px;
    top: -170px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(12 10 16 / 0.34), rgb(12 10 16 / 0.14) 50%, rgb(12 10 16 / 0));
    transform: translate3d(14px, var(--suelo-y, 94px), -10px) rotateX(90deg);
    pointer-events: none;
  }
  /* Cada bloque: un cubo de 62 px con 6 caras; centrado en su punto con márgenes de -31 px */
  .bloque {
    position: absolute;
    left: -31px;
    top: -31px;
    width: 62px;
    height: 62px;
    transform-style: preserve-3d;
    /* Quieto, cada bloque ocupa su celda del cubo final (centrado: sin los 40 px de más) */
    transform: translate3d(var(--x3), calc(var(--y3) - 40px), var(--z3));
  }
  /*
    Caras con color fijo violeta (frente/atrás, tapa clara, costados oscuros).
    backface-visibility: las caras que miran hacia atrás no se pintan (el cubo es cerrado y opaco).
  */
  .bloque i {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 3px;
    backface-visibility: hidden;
  }
  .frente { background: var(--color-violeta); transform: translateZ(31px); }
  .atras { background: var(--color-violeta); transform: rotateY(180deg) translateZ(31px); }
  .arriba { background: var(--color-violeta-claro); transform: rotateX(90deg) translateZ(31px); }
  .abajo { background: var(--color-violeta-oscuro); transform: rotateX(-90deg) translateZ(31px); }
  .der { background: var(--color-violeta-oscuro); transform: rotateY(90deg) translateZ(31px); }
  .izq { background: var(--color-violeta-oscuro); transform: rotateY(-90deg) translateZ(31px); }

  /*
    Cambio de tono sin animar colores: una capa ::after encima del violeta, con el color FIJO
    del mini cubo, que se enciende con opacity.
    Solo existe en los bloques cuyo tono cambia (conMini en src/data/bloques.ts).
  */
  .con-mini i::after {
    content: '';
    position: absolute;
    inset: -1px;
    box-sizing: border-box;
    border: inherit;
    border-radius: inherit;
    opacity: 0;
  }
  .con-mini .frente::after, .con-mini .atras::after { background: var(--cf); }
  .con-mini .arriba::after { background: var(--ct); }
  .con-mini .abajo::after, .con-mini .der::after, .con-mini .izq::after { background: var(--cs); }

  .etiquetas {
    display: grid;
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .etiqueta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .etiqueta strong {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Texto de acento sobre fondo claro: morado oscuro (manual). El violeta daba 4,2:1, bajo AA */
    color: var(--color-violeta-oscuro);
  }
  .etiqueta span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-negro);
  }

  .frase {
    margin: 56px auto 0;
    max-width: 760px;
    text-align: center;
  }
  /* Misma escala de títulos de sección que el resto de la página en celular y tablet (DESIGN.md) */
  .frase h2 {
    font-size: clamp(30px, 8.6vw, 38px);
    line-height: 1.06;
  }
  .frase p {
    margin: 14px 0 0;
    color: var(--color-tinta-2);
  }

  @media (width >= 56.25rem) {
    .portada {
      --pad: 32px;
    }
    .texto-hero {
      gap: 30px;
      width: min(720px, 50%);
    }
    /* max-width: siempre en 3 líneas como el diseño (Software a la / medida que / trabaja por ti.).
       Así la línea más larga mide ~6,5em en cualquier pantalla y el cubo se centra con esa medida (--ix) */
    .h1 {
      font-size: clamp(44px, 5.2vw, 98px);
      max-width: 7em;
    }
    .sub {
      font-size: clamp(20px, 1.4vw, 25px);
    }
    /* Versión estática en computador: cubo a 80 % bajo el texto y Kai al lado */
    .escena {
      --grupo-alto: 340px;
      --par-x: -91px;
      --par-y: 32px;
      --kx: 187.4px;
      --ky: 76.2px;
      --kz: -47px;
      --kai-lado: 335px;
    }
    .camara {
      scale: 0.8;
    }
    .etiquetas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      text-align: center;
    }
    .frase h2 {
      font-size: clamp(32px, 3.6vw, 52px);
    }
  }

  /* =========================================================================
     2. ESCENA ANIMADA CON EL SCROLL (computador)
     ========================================================================= */
  @supports (animation-timeline: view()) and (timeline-scope: none) {
    @media (prefers-reduced-motion: no-preference) {
      /* 2900 px de scroll para una escena de una pantalla que se queda pegada (sticky) */
      .portada {
        height: 2900px;
        view-timeline: --hero block;
        /* Tamaño del cubo inicial (escala de la cámara) junto a Kai: crece con la pantalla */
        --s0: 0.65;
        /* Computadores angostos (900–1099 px, iPad horizontal): la nube y los 3 mini cubos a 78 % para que
           los textos de los costados no se salgan de la pantalla */
        --k2: 0.78;
      }
      @media (width >= 68.75rem) {
        .portada { --s0: 0.85; --k2: 1; }
      }
      @media (width >= 93.75rem) {
        .portada { --s0: 1; }
      }
      .escena-fija {
        position: sticky;
        top: 76px;
        height: calc(100vh - 76px);
        min-height: 620px;
        max-height: 980px;
        overflow: hidden;
        padding: 0;
      }
      .marco {
        position: relative;
        height: 100%;
      }

      .texto-hero {
        position: absolute;
        left: var(--pad);
        top: 50%;
        transform: translateY(-50%);
        z-index: 3;
        animation: portada-salida-hero linear both;
        animation-timeline: --hero;
        animation-range: contain 8% contain 22%;
      }

      /*
        Escena 3D en tres capas:
        .escena (perspectiva = la lente) → .grupo (lleva todo al carril al final)
        → .camara (gira y se aleja) → .bloque × 27 (cada uno viaja entre sus 5 posiciones).
        --cx/--cy: distancia del centro de la escena al cubo del carril derecho.
      */
      .escena {
        position: absolute;
        inset: 0;
        margin: 0;
        pointer-events: none;
        --cx: calc(50cqw - max(20px, 50cqw - 680px) - 60px);
        --cy: calc(50vh - 76px - clamp(620px, 100vh - 76px, 980px) / 2);
        /*
          Cubo inicial (0–6 %), según la pantalla: centrado entre el final del texto y el borde derecho
          del contenido, y a la altura del texto. Lo más ancho del texto es el título (línea más larga
          ≈ 6,5 × clamp(44px, 5.2vw, 98px)) o, en pantallas angostas, el párrafo (36ch ≈ 21,6 × su letra).
          El centro de ese espacio queda a medio texto del centro de la escena. --iz acerca el cubo a la
          lente (se ve del tamaño de antes) y con la perspectiva todo se ve 1,17 veces más lejos del
          centro: 0,5 / 1,17 ≈ 0,427. Los -4 px y --iy corrigen lo que la perspectiva corre el cubo
          (medido en pantallas de 1024 a 1920 px de ancho).
          Van en .escena (y no en .grupo) porque Kai, parado en la tapa, también los usa.
        */
        /*
          Junto a Kai: el conjunto Kai + cubo (no solo el cubo) va centrado en ese espacio, así que el
          cubo se corre a la izquierda (112 px × --s0, ya descontada la perspectiva) y un poco abajo.
          El cubo y Kai se achican con la pantalla (--s0) para que el conjunto no choque con el texto.
        */
        --ix: calc(max(6.5 * clamp(44px, 5.2vw, 98px), 21.6 * clamp(20px, 1.4vw, 25px)) * 0.427 - 4px - 112px * var(--s0));
        --iy: calc(40px * var(--s0) + 10px);
        --iz: 218px;
        /* Pies de Kai respecto al centro del cubo y tamaño de su cuadro (todo crece con --s0) */
        --kx: calc(236px * var(--s0));
        --ky: calc(96px * var(--s0));
        --kz: calc(-59px * var(--s0));
        --kai-lado: calc(425px * var(--s0));
        animation: portada-perspectiva linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .grupo {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 0;
        height: 0;
        transform-style: preserve-3d;
        /* Escala final: cubo de 186 px (3 × 62) → cubo del carril de 88 px.
           0.485 y no 88/186 = 0.473: el vidrio tiene borde de 1,5 px y medido en pantalla quedaba ~3 px más grande */
        --k: 0.485;
        /* El cubo final está armado 40 px bajo el centro: al llegar al carril quedaba 13 px más abajo */
        --dy: -13px;
        animation: portada-grupo linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .camara {
        left: 0;
        top: 0;
        scale: none;
        animation: portada-camara linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .bloque {
        animation: portada-bloque linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      /* La sombra del piso se va apenas el cubo empieza a desarmarse */
      .suelo {
        animation: portada-suelo linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      /* La capa de color: animación solo de opacity, que el compositor hace sin el hilo principal */
      .con-mini i::after {
        animation: portada-tono-mini linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      /*
        Relevo con el cubo de vidrio (que aparece encima, en CuboViajero): cada bloque se apaga en su
        turno (--d) entre el 92 y el 99 %. La opacity va en las caras y no en .grupo: en un elemento
        con preserve-3d, opacity < 1 aplana el 3D y el cubo saltaba al perder la perspectiva.
      */
      .bloque i {
        animation: portada-a-vidrio linear both;
        animation-timeline: --hero;
        animation-range: contain calc(92% + var(--d) * 3%) contain calc(96% + var(--d) * 3%);
      }

      /*
        Kai junto al cubo inicial (0–6 %). Mismo traslado que .grupo y, encima, el punto del piso donde van
        sus pies (--kx --ky --kz, ya girado por la cámara). Como .kai-ancla es hija de .escena, recibe la
        misma perspectiva que el cubo y queda parado en su mismo piso.
      */
      .kai-ancla {
        left: 50%;
        top: 50%;
        transform: translate3d(var(--ix), var(--iy), var(--iz)) translate3d(var(--kx), var(--ky), var(--kz));
        /* x del vuelo: avanza parejo (ver abajo) */
        animation: portada-kai-vuela-x linear both;
        animation-timeline: --hero;
        animation-range: contain 5% contain 18%;
      }
      /*
        Cuando el cubo empieza a desarmarse (6 %), la explosión lanza a Kai: se agacha un instante, sale
        volando hacia arriba y hacia atrás dando vueltas, y cae con los bloques hasta perderse (5–18 %).
        Para que el vuelo sea una parábola, cada parte va en su propia propiedad: x avanza parejo (.kai-ancla),
        y sube frenando y cae acelerando (translate) y el giro y el desvanecido van aparte (rotate).
        Si el 3D ya cargó, además da una vuelta sobre sí mismo (escena.ts, con este mismo tramo).
      */
      .kai-ancla :global(.kai-vivo) {
        animation:
          portada-kai-vuela-y linear both,
          portada-kai-gira linear both;
        animation-timeline: --hero, --hero;
        animation-range: contain 5% contain 18%;
      }

      .etiquetas {
        position: absolute;
        inset: 0;
        display: block;
        margin: 0;
        pointer-events: none;
      }
      .etiqueta {
        position: absolute;
        left: 50%;
        top: 50%;
        width: calc(300px - (1 - var(--k2)) * 270px);
        margin-left: calc(-150px + (1 - var(--k2)) * 135px);
        text-align: center;
        opacity: 0;
        animation: portada-etiqueta linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }

      .frase {
        position: absolute;
        left: 50%;
        top: 9%;
        width: min(760px, 90%);
        margin: 0;
        transform: translateX(-50%);
        z-index: 4;
        opacity: 0;
        animation: portada-frase linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
    }

    /* =========================================================================
       3. ESCENA ANIMADA EN CELULAR (< 900 px)
       ========================================================================= */
    @media (prefers-reduced-motion: no-preference) and (width < 56.25rem) {
      /*
        1.900 px de scroll (antes 2.600): la misma historia, más compacta para el pulgar. El cubo ya no
        viaja al carril: termina armado aquí, bajo la frase, y vuelve a aparecer armado en el contacto.
      */
      .portada {
        height: 1900px;
        --s0: 0.9;
      }
      .escena-fija {
        top: 64px;
        height: calc(100vh - 64px);
        min-height: 600px;
        max-height: 760px;
      }
      .texto-hero {
        top: 24px;
        width: calc(100% - 2 * var(--pad));
        transform: none;
        animation-name: portada-salida-hero-movil;
      }
      /*
        Kai + cubo bajo el texto. El texto termina a ~324 px del borde de arriba de la escena en todos los
        celulares, así que el centro del espacio libre de abajo queda siempre ~162 px bajo el centro de la
        escena: ahí va el centro del conjunto (el cubo se corre a la izquierda para dejarle sitio a Kai).
        Sin la lente que se acerca al carril: en celular el cubo no viaja.
      */
      .escena {
        --ix: calc(-65px * var(--s0));
        --iy: calc(162px - 46px * var(--s0));
        --iz: 0px;
        --kx: calc(141px * var(--s0));
        --ky: calc(128.5px * var(--s0));
        --kz: calc(-111.6px * var(--s0));
        --kai-lado: calc(253px * var(--s0));
        animation: none;
        perspective: 1500px;
      }
      /* En celular la cámara va a 60 % (scale independiente del transform animado) */
      .camara {
        scale: 0.6;
        animation-name: portada-camara-movil;
      }
      .grupo {
        animation-name: portada-grupo-movil;
      }
      .bloque {
        animation-name: portada-bloque-movil;
      }
      /* El cubo inicial va 130 px más abajo (portada-bloque-movil): su piso también */
      .suelo {
        --suelo-y: 224px;
      }
      /* El cubo se queda (no se vuelve vidrio) */
      .bloque i {
        animation: none;
      }
      /*
        Los mini cubos van en columna a la izquierda y su texto a la derecha, sin pasarse del margen:
        el texto empieza 6 px a la izquierda del centro y llega justo hasta el margen derecho.
      */
      .etiqueta {
        width: calc(50% - var(--pad) + 6px);
        margin-left: -6px;
        text-align: left;
        animation-name: portada-etiqueta-movil;
      }
      .etiqueta strong {
        font-size: 12px;
        letter-spacing: 0.12em;
      }
      .etiqueta span {
        font-size: 15px;
        text-wrap: pretty;
      }
      .frase {
        top: 5%;
      }
    }
    @media (prefers-reduced-motion: no-preference) and (width >= 23.75rem) and (width < 40rem) {
      .portada {
        --s0: 1;
      }
    }
    @media (prefers-reduced-motion: no-preference) and (width >= 25.75rem) and (width < 40rem) {
      .portada {
        --s0: 1.08;
      }
    }
    /*
      Tablet (640–899 px): dos columnas. Texto a la izquierda, centrado en alto; Kai + cubo a la derecha.
      Después sigue la misma historia del celular (mini cubos en columna, cubo final bajo la frase).
    */
    @media (prefers-reduced-motion: no-preference) and (width >= 40rem) and (width < 56.25rem) {
      .portada {
        --s0: 0.95;
      }
      /* La escena usa todo el alto de la tablet (en celular se limita a 760 px) para no dejar vacío abajo */
      .escena-fija {
        max-height: 1100px;
      }
      .texto-hero {
        top: max(24px, 50% - 200px);
        width: 47%;
      }
      /* En 3 líneas, como en computador, para que quepa en su columna */
      .h1 {
        font-size: clamp(40px, 6.6vw, 58px);
        max-width: 7em;
      }
      .escena {
        --ix: calc(26cqw - 65px * var(--s0));
