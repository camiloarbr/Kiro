---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// PROVISIONAL (paso 2): secciones de relleno con los id reales para probar los enlaces.
// Cada una se reemplaza por su componente en los pasos 3 a 8.
const relleno = [
  { id: 'inicio', nombre: 'Portada', paso: 3 },
  { id: 'dia', nombre: 'Tu día, con y sin Kiro', paso: 5 },
  { id: 'servicios', nombre: 'Servicios', paso: 6 },
  { id: 'demo', nombre: 'Demo de Kiro Bot', paso: 7 },
  { id: 'como', nombre: 'Cómo trabajamos', paso: 8 },
  { id: 'contacto', nombre: 'Contacto', paso: 8 },
];
---

<BaseLayout>
  <Header />
  <main>
    {
      relleno.map((s, i) => (
        <section id={s.id} class:list={['flex min-h-[560px] items-center', i % 2 ? 'bg-lav-2' : 'bg-lav']}>
          <div class="contenedor w-full">
            <p class="eyebrow">Paso {s.paso}</p>
            <h2 class="titulo mt-4 text-[clamp(34px,4vw,56px)]">{s.nombre}</h2>
          </div>
        </section>
      ))
    }
  </main>
  <Footer />
</BaseLayout>
