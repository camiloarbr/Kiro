---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CuboViajero from '../components/CuboViajero.astro';
import TuDia from '../components/TuDia.astro';
import Servicios from '../components/Servicios.astro';
import DemoKiroBot from '../components/DemoKiroBot.astro';
import ComoTrabajamos from '../components/ComoTrabajamos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Transicion from '../components/Transicion.astro';
---

<BaseLayout>
  <Header />
  <main class="recorrido">
    <CuboViajero />
    <Hero />
    <div class="flujo">
      <TuDia />
      <Transicion desde="#f7f2ff" hacia="var(--color-negro)" />
      <Servicios />
      <DemoKiroBot />
      <ComoTrabajamos />
      <Contacto />
    </div>
  </main>
  <Transicion desde="var(--color-lav)" hacia="var(--color-negro)" />
  <Footer />
</BaseLayout>

<style>
  /*
    .recorrido es el «escenario» del cubo:
    - container-type permite medir en cqw (ancho de este contenedor) para ubicar el carril.
    - timeline-scope sube las líneas de tiempo --hero (portada) y --flujo (secciones)
      hasta aquí, para que el cubo, que es hermano de ellas, pueda usarlas.
  */
  .recorrido {
    position: relative;
    container-type: inline-size;
    timeline-scope: --hero, --flujo;
  }
  .flujo {
    position: relative;
    view-timeline: --flujo block;
  }
</style>
