---
// Portada «bloques-cursor». Las posiciones de los 27 bloques salen de src/data/bloques.ts.
import { bloques, pasos } from '../data/bloques';
---

<section id="inicio" class="portada">
  <div class="escena-fija">
    <div class="contenedor marco">
      <div class="resplandor" aria-hidden="true"></div>

      <div class="texto-hero">
        <h1 class="titulo h1">
          Software a la medida que <span class="text-violeta">trabaja por ti.</span><span class="cursor" aria-hidden="true"></span>
        </h1>
        <p class="sub">Páginas web, agentes de IA y automatizaciones hechas para cómo opera tu negocio.</p>
        <div><a class="btn btn-hero" href="#servicios">Conoce más <span aria-hidden="true">→</span></a></div>
      </div>

      <div class="escena">
        <div class="grupo" aria-hidden="true">
          <div class="camara">
            {
              bloques.map((estilo) => (
                <div class="bloque" style={estilo}>
                  <i class="frente" />
                  <i class="atras" />
                  <i class="arriba" />
                  <i class="abajo" />
                  <i class="der" />
                  <i class="izq" />
                </div>
              ))
            }
          </div>
        </div>
        <ul class="etiquetas">
          {
            pasos.map((p) => (
              <li class="etiqueta" style={`--lx:${p.x}px;--ly:${p.y}px;--mlx:${p.xMovil}px;--mly:${p.yMovil}px`}>
                <strong>{p.titulo}</strong>
                <span>{p.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="frase">
        <h2 class="titulo">Tecnología que se adapta <span class="text-violeta">a tu negocio.</span></h2>
        <p>Automatizamos lo repetitivo para que tu equipo se enfoque en lo importante.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Colores de las caras registrados con @property: así el navegador puede interpolarlos
     (una variable normal saltaría de un color a otro sin transición). */
  @property --vf {
    syntax: '<color>';
    inherits: true;
    initial-value: #8b2cf5;
  }
  @property --vt {
    syntax: '<color>';
    inherits: true;
    initial-value: #b07cff;
  }
  @property --vs {
    syntax: '<color>';
    inherits: true;
    initial-value: #5b17b8;
  }

  /* =========================================================================
     1. VERSIÓN ESTÁTICA (base)
     Firefox, navegadores sin scroll-driven animations y «reducir movimiento»:
     título, el cubo de bloques quieto, los tres pasos en lista y la frase.
     ========================================================================= */
  .portada {
    --pad: 24px;
    position: relative;
    background: linear-gradient(180deg, var(--color-lav) 0%, var(--color-lav-2) 60%, var(--color-lav-3) 100%);
  }
  .escena-fija {
    padding: 40px 0 96px;
  }

  .texto-hero {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .h1 {
    font-size: clamp(36px, 10vw, 52px);
    line-height: 1;
  }
  /* El cursor de la marca al final del título */
  .cursor {
    display: inline-block;
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.08em;
    vertical-align: 0.02em;
    background: var(--color-violeta);
  }
  .sub {
    margin: 0;
    font-size: 18px;
    color: var(--color-tinta-2);
    max-width: 36ch;
  }
  .btn-hero {
    min-height: 56px;
    padding: 0 30px;
    font-size: 17px;
  }

  .escena {
    position: relative;
    margin-top: 40px;
    perspective: 1500px;
  }
  .grupo {
    position: relative;
    height: 240px;
  }
  .camara {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(-35deg);
    scale: 0.6;
  }
  /* Cada bloque: un cubo de 62 px con 6 caras; centrado en su punto con márgenes de -31 px */
  .bloque {
    position: absolute;
    left: -31px;
    top: -31px;
    width: 62px;
    height: 62px;
    transform-style: preserve-3d;
    /* Quieto, cada bloque ocupa su celda del cubo final (centrado: sin los 40 px de más) */
    transform: translate3d(var(--x3), calc(var(--y3) - 40px), var(--z3));
  }
  .bloque i {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 3px;
  }
  .frente { background: var(--vf); transform: translateZ(31px); }
  .atras { background: var(--vf); transform: rotateY(180deg) translateZ(31px); }
  .arriba { background: var(--vt); transform: rotateX(90deg) translateZ(31px); }
  .abajo { background: var(--vs); transform: rotateX(-90deg) translateZ(31px); }
  .der { background: var(--vs); transform: rotateY(90deg) translateZ(31px); }
  .izq { background: var(--vs); transform: rotateY(-90deg) translateZ(31px); }

  .etiquetas {
    display: grid;
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .etiqueta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .etiqueta strong {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-violeta);
  }
  .etiqueta span {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-negro);
  }

  .frase {
    margin: 56px auto 0;
    max-width: 760px;
    text-align: center;
  }
  .frase h2 {
    font-size: 30px;
    line-height: 1.06;
  }
  .frase p {
    margin: 14px 0 0;
    color: var(--color-tinta-2);
  }

  .resplandor {
    display: none;
  }

  @media (width >= 56.25rem) {
    .portada {
      --pad: 32px;
    }
    .texto-hero {
      gap: 30px;
      width: min(720px, 50%);
    }
    .h1 {
      font-size: clamp(44px, 5.2vw, 98px);
    }
    .sub {
      font-size: clamp(20px, 1.4vw, 25px);
    }
    .grupo {
      height: 340px;
    }
    .camara {
      scale: 1;
    }
    .etiquetas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      text-align: center;
    }
    .frase h2 {
      font-size: clamp(32px, 3.6vw, 52px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: portada-parpadeo 1.05s steps(1) infinite;
    }
  }

  /* =========================================================================
     2. ESCENA ANIMADA CON EL SCROLL (computador)
     ========================================================================= */
  @supports (animation-timeline: view()) and (timeline-scope: none) {
    @media (prefers-reduced-motion: no-preference) {
      /* 2900 px de scroll para una escena de una pantalla que se queda pegada (sticky) */
      .portada {
        height: 2900px;
        view-timeline: --hero block;
      }
      .escena-fija {
        position: sticky;
        top: 76px;
        height: calc(100vh - 76px);
        min-height: 620px;
        max-height: 980px;
        overflow: hidden;
        padding: 0;
      }
      .marco {
        position: relative;
        height: 100%;
      }

      /* Resplandor de abajo: se apaga al final para que el borde de la escena no deje un corte */
      .resplandor {
        display: block;
        position: absolute;
        left: -10%;
        right: -10%;
        bottom: -140px;
        height: 420px;
        pointer-events: none;
        background:
          radial-gradient(50% 60% at 55% 70%, rgb(139 44 245 / 0.45), rgb(139 44 245 / 0)),
          radial-gradient(40% 50% at 25% 90%, rgb(176 124 255 / 0.6), rgb(176 124 255 / 0));
        animation: portada-resplandor-se-apaga linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }

      .texto-hero {
        position: absolute;
        left: var(--pad);
        top: 50%;
        transform: translateY(-50%);
        z-index: 3;
        animation: portada-salida-hero linear both;
        animation-timeline: --hero;
        animation-range: contain 8% contain 22%;
      }

      /*
        Escena 3D en tres capas:
        .escena (perspectiva = la lente) → .grupo (lleva todo al carril al final)
        → .camara (gira y se aleja) → .bloque × 27 (cada uno viaja entre sus 5 posiciones).
        --cx/--cy: distancia del centro de la escena al cubo del carril derecho.
      */
      .escena {
        position: absolute;
        inset: 0;
        margin: 0;
        pointer-events: none;
        --cx: calc(50cqw - max(20px, 50cqw - 680px) - 60px);
        --cy: calc(50vh - 76px - clamp(620px, 100vh - 76px, 980px) / 2);
        animation: portada-perspectiva linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .grupo {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 0;
        height: 0;
        transform-style: preserve-3d;
        /* Escala final: cubo de 186 px (3 × 62) → cubo del carril de 88 px */
        --k: 0.473;
        /* El cubo final está armado 40 px bajo el centro: al llegar al carril quedaba 13 px más abajo */
        --dy: -13px;
        animation: portada-grupo linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .camara {
        left: 0;
        top: 0;
        animation: portada-camara linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .bloque {
        animation: portada-bloque linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }

      .etiquetas {
        position: absolute;
        inset: 0;
        display: block;
        margin: 0;
        pointer-events: none;
      }
      .etiqueta {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 300px;
        margin-left: -150px;
        text-align: center;
        opacity: 0;
        animation: portada-etiqueta linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }

      .frase {
        position: absolute;
        left: 50%;
        top: 9%;
        width: min(760px, 90%);
        margin: 0;
        transform: translateX(-50%);
        z-index: 4;
        opacity: 0;
        animation: portada-frase linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
    }

    /* =========================================================================
       3. ESCENA ANIMADA EN CELULAR (< 900 px)
       ========================================================================= */
    @media (prefers-reduced-motion: no-preference) and (width < 56.25rem) {
      .portada {
        height: 2600px;
      }
      .escena-fija {
        top: 64px;
        height: calc(100vh - 64px);
        min-height: 600px;
        max-height: 760px;
      }
      .texto-hero {
        top: 24px;
        width: calc(100% - 2 * var(--pad));
        transform: none;
        animation-name: portada-salida-hero-movil;
      }
      .escena {
        --cx: calc(50cqw - 28px);
        --cy: calc(100vh - 118px - 64px - clamp(600px, 100vh - 64px, 760px) / 2);
      }
      /* En celular la cámara va a 60 % (scale independiente del transform animado).
         Escala final: 186 px × 0,6 × k = 32 px, el cubo del carril en celular. */
      .camara {
        scale: 0.6;
      }
      .grupo {
        --k: 0.2867;
        --dy: -5px;
      }
      .bloque {
        animation-name: portada-bloque-movil;
      }
      /* Los mini cubos van en columna y su texto a la derecha */
      .etiqueta {
        width: 180px;
        margin-left: 10px;
        text-align: left;
        animation-name: portada-etiqueta-movil;
      }
      .etiqueta strong {
        font-size: 12px;
        letter-spacing: 0.12em;
      }
      .etiqueta span {
        font-size: 15px;
      }
      .frase {
        top: 5%;
      }
    }
  }

  /* =========================================================================
     KEYFRAMES (valores de docs/diseno/referencia/portada-bloques-cursor.dc.html)
     ========================================================================= */
  @keyframes portada-parpadeo {
    50% { opacity: 0; }
  }
  @keyframes portada-salida-hero {
    to { opacity: 0; visibility: hidden; transform: translate(-80px, -50%); }
  }
  @keyframes portada-salida-hero-movil {
    to { opacity: 0; visibility: hidden; transform: translateY(-60px); }
  }
  @keyframes portada-resplandor-se-apaga {
    0%, 88% { opacity: 1; }
    100% { opacity: 0; }
  }

  /* Al final la lente se acerca al carril para que el cubo coincida con el que baja con la página */
  @keyframes portada-perspectiva {
    0%, 84% { perspective: 1500px; perspective-origin: 50% 50%; }
    95%, 100% { perspective: 700px; perspective-origin: calc(50% + var(--cx)) calc(50% + var(--cy)); }
  }
  /* 84–94 %: todo el conjunto vuela al carril y se encoge; 94–97 % se apaga (lo reemplaza el cubo viajero) */
  @keyframes portada-grupo {
    0%, 84% { transform: translate3d(0, 0, 0) scale(1); opacity: 1; }
    94% { transform: translate3d(var(--cx), calc(var(--cy) + var(--dy)), 0) scale(var(--k)); opacity: 1; }
    97%, 100% { transform: translate3d(var(--cx), calc(var(--cy) + var(--dy)), 0) scale(var(--k)); opacity: 0; }
  }
  /* La cámara gira el conjunto; en el «ik» se aleja (scale 0.8) y termina en la pose del cubo viajero */
  @keyframes portada-camara {
    0%, 5% { transform: rotateX(-24deg) rotateY(-35deg) scale(1); }
    16% { transform: rotateX(-14deg) rotateY(-70deg) scale(1); }
    28%, 38% { transform: rotateX(-6deg) rotateY(-16deg) scale(0.8); }
    48%, 64% { transform: rotateX(-22deg) rotateY(-24deg) scale(1); }
    76% { transform: rotateX(-24deg) rotateY(55deg) scale(1); }
    84%, 100% { transform: rotateX(-24deg) rotateY(-35deg) scale(1); }
  }
  /*
    El viaje de cada bloque: cubo → nube (gira) → «ik» → mini cubo → cubo final.
    Las posiciones vienen de sus variables (--x0, --xc, --x1…) y los colores de las caras
    cambian con --vf/--vt/--vs: violeta en los cubos, grafito/violeta en el «ik», un tono por mini cubo.
  */
  @keyframes portada-bloque {
    0%, 5% { transform: translate3d(var(--x0), var(--y0), var(--z0)); --vf: #8b2cf5; --vt: #b07cff; --vs: #5b17b8; }
    16% { transform: translate3d(var(--xc), var(--yc), var(--zc)) rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz)); --vf: var(--of); --vt: var(--ot); --vs: var(--os); }
    28%, 38% { transform: translate3d(var(--x1), var(--y1), var(--z1)); --vf: var(--of); --vt: var(--ot); --vs: var(--os); }
    48%, 64% { transform: translate3d(var(--x2), var(--y2), var(--z2)); --vf: var(--cf); --vt: var(--ct); --vs: var(--cs); }
    76%, 100% { transform: translate3d(var(--x3), var(--y3), var(--z3)); --vf: #8b2cf5; --vt: #b07cff; --vs: #5b17b8; }
  }
  /* Celular: cubo inicial centrado y más abajo, nube más compacta y mini cubos en columna */
  @keyframes portada-bloque-movil {
    0%, 5% { transform: translate3d(0px, calc(var(--y0) + 150px), var(--z0)) translateX(calc(var(--x0) - 380px)); --vf: #8b2cf5; --vt: #b07cff; --vs: #5b17b8; }
    16% { transform: translate3d(calc((var(--xc) - 370px) * 0.7), calc(var(--yc) * 0.9 + 100px), var(--zc)) rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz)); --vf: var(--of); --vt: var(--ot); --vs: var(--os); }
    28%, 38% { transform: translate3d(var(--x1), var(--y1), var(--z1)); --vf: var(--of); --vt: var(--ot); --vs: var(--os); }
    48%, 64% { transform: translate3d(var(--mx2), calc(var(--y2) + var(--my2)), var(--z2)); --vf: var(--cf); --vt: var(--ct); --vs: var(--cs); }
    76%, 100% { transform: translate3d(var(--x3), var(--y3), var(--z3)); --vf: #8b2cf5; --vt: #b07cff; --vs: #5b17b8; }
  }
  @keyframes portada-etiqueta {
    0%, 46% { opacity: 0; transform: translate(var(--lx), calc(var(--ly) + 24px)); }
    52%, 66% { opacity: 1; transform: translate(var(--lx), var(--ly)); }
    72%, 100% { opacity: 0; transform: translate(var(--lx), calc(var(--ly) - 16px)); }
  }
  @keyframes portada-etiqueta-movil {
    0%, 46% { opacity: 0; transform: translate(var(--mlx), calc(var(--mly) + 24px)); }
    52%, 66% { opacity: 1; transform: translate(var(--mlx), var(--mly)); }
    72%, 100% { opacity: 0; transform: translate(var(--mlx), calc(var(--mly) - 16px)); }
  }
  @keyframes portada-frase {
    0%, 72% { opacity: 0; transform: translate(-50%, 24px); }
    82%, 100% { opacity: 1; transform: translate(-50%, 0); }
  }
</style>
