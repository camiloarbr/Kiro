---
import { correoUrl } from '../data/contacto';
import KaiVivo from './KaiVivo.astro';
---

<section id="contacto" class="contacto pt-24 pb-18 md:pt-[150px] md:pb-[110px]">
  <div class="contenedor flex flex-col items-center gap-[22px] text-center">
    <!-- Aquí termina el recorrido de Kai: al llegar da un saltito y mira el botón del correo -->
    <div class="bot revela" aria-hidden="true"><KaiVivo lugar="contacto" ancho={190} /></div>
    <!-- Morado oscuro: el violeta de acento sobre este lavanda no alcanza el contraste AA -->
    <span class="eyebrow revela items-center">Hablemos</span>
    <h2 class="titulo revela max-w-[16ch] text-[clamp(36px,4.6vw,64px)] leading-[1.04]">
      ¿Qué te quita <span class="text-violeta">tiempo</span> hoy?
    </h2>
    <p class="revela-2 m-0 max-w-[46ch] text-tinta-2">
      Cuéntanos el problema y te mostramos cómo lo resolvemos con software.
    </p>
    <div class="revela-2 flex justify-center">
      <a class="btn" href={correoUrl} data-kai-mira data-kai-foco>Escríbenos un correo</a>
    </div>
  </div>
</section>

<style>
  /* El cuadro de Kai trae aire arriba (saltito) y abajo (sombra): los márgenes negativos lo compensan */
  .bot {
    --kai-lado: 144px;
    margin: -16px 0 -14px;
  }
  @media (width >= 56.25rem) {
    .bot {
      --kai-lado: 190px;
      margin: -22px 0 -18px;
    }
  }
  .contacto {
    background: linear-gradient(180deg, var(--color-violeta-claro) 0%, var(--color-lav-2) 60%, var(--color-lav) 100%);
  }
</style>
