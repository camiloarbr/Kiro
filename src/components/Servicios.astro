---
import Olas from './Olas.astro';
import { servicios } from '../data/servicios';
import Mascota from './Mascota.astro';
---

<section id="servicios" class="servicios">
  <Olas />

  <div class="contenedor interior">
    <div class="cabeza">
      <h2 class="titulo titulo-grande revela">
        ¿Qué podemos <span class="acento">construir</span> para ti?
      </h2>
      <p class="revela-2">
        Partimos de módulos propios y los ajustamos a tu operación. Empiezas por lo que más te duele y sumas lo demás.
      </p>
    </div>

    <div class="tarjetas" data-kai-foco>
      {
        servicios.map((s, i) => (
          <article class:list={['tarjeta', { grande: s.grande }]} data-io>
            <div class="arte" aria-hidden="true">
              <svg viewBox="0 0 300 180" set:html={s.arte} />
              {'conBot' in s && s.conBot && <Mascota ancho={118} class="asoma" />}
            </div>
            <div class="cuerpo">
              <h3>{s.titulo}</h3>
              <p>{s.descripcion}</p>
              <ul>
                {s.etiquetas.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="revela-2 mt-10 flex justify-center md:mt-14">
      <a class="btn" href="#contacto" data-kai-mira>Cuéntanos qué necesitas <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .servicios {
    position: relative;
    overflow: hidden;
    padding: 88px 0 80px;
    color: var(--color-blanco);
    /* Negro plano: empata sin línea con el final de la franja <Transicion> que viene de «Tu día» */
    background: var(--color-negro);
  }
  .interior {
    position: relative;
    z-index: 1;
  }

  /* ---------- Encabezado ---------- */
  .cabeza {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }
  .cabeza p {
    margin: 0;
    max-width: 52ch;
    color: var(--color-texto-oscuro);
  }
  .titulo-grande {
    max-width: 14ch;
    /* Celular y tablet: la misma escala de títulos de sección que el resto de la página (DESIGN.md) */
    font-size: clamp(30px, 8.6vw, 38px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-white);
  }
  /* Acento sobre negro: morado claro (manual), en color plano */
  .acento {
    color: var(--color-violeta-claro);
  }

  /* ---------- Tarjetas ----------
     Celular: tarjeta compacta (ilustración más baja, menos relleno y etiquetas más juntas) para que las
     cinco no ocupen tres pantallas y media. Mismo contenido, mismas ilustraciones y misma jerarquía. */
  .tarjetas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin-top: 36px;
    perspective: 1400px; /* da profundidad al rotateX con que entran */
  }
  .tarjeta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-grafito);
    border: 1px solid rgb(217 196 255 / 0.16);
    transform-origin: 50% 100%;
    transition:
      border-color 0.3s,
      translate 0.4s var(--ease-kairo);
  }
  /* Hover con «translate» (no transform) para no chocar con la animación de entrada */
  .tarjeta:hover {
    border-color: rgb(217 196 255 / 0.4);
    translate: 0 -6px;
  }

  .arte {
    position: relative;
    height: 96px;
    overflow: hidden;
    background: var(--color-profundo-3);
  }
  .arte svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-lav-media);
    stroke-width: 2.5;
  }
  /* Kai se asoma desde abajo en la tarjeta de agentes de IA y sube un poco al pasar el mouse */
  .arte :global(.asoma) {
    position: absolute;
    right: 8%;
    bottom: -34px;
    width: 72px;
    height: auto;
    /* Sombra neutra con desplazamiento: da profundidad sin halo de color */
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.45));
    transition: translate 0.5s var(--ease-kairo);
  }
  .tarjeta:hover .arte :global(.asoma) {
    translate: 0 -14px;
  }
  /* El SVG llega por set:html, así que su contenido no lleva el atributo de estilos con alcance */
  .arte svg :global(.fill) {
    fill: var(--color-violeta);
    stroke: var(--color-lav-media);
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
  }
  .cuerpo h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700; /* el preflight de Tailwind quita la negrita por defecto de h3 */
    letter-spacing: -0.02em;
    color: var(--color-white);
  }
  .cuerpo p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-texto-oscuro);
  }
  .cuerpo ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .cuerpo li {
    padding: 3px 11px;
    border: 1px solid rgb(217 196 255 / 0.22);
    border-radius: 999px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-lav-media);
    /* Si una etiqueta parte en dos líneas, que no quede una palabra sola abajo («negocio», «persona») */
    text-wrap: balance;
  }

  /* ---------- Tablet (640–899 px): dos columnas; la última tarjeta, a lo ancho con la ilustración al lado ---------- */
  @media (width >= 40rem) and (width < 56.25rem) {
    .tarjetas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .arte {
      height: 120px;
    }
    .tarjeta:last-child {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
    .tarjeta:last-child .arte {
      height: auto;
      min-height: 140px;
    }
  }

  /* ---------- Computador ---------- */
  @media (width >= 56.25rem) {
    .servicios {
      padding: 170px 0 150px;
    }
    .titulo-grande {
      font-size: clamp(40px, 5.2vw, 78px);
    }
    .tarjetas {
      gap: 18px;
    }
    .cuerpo {
      gap: 10px;
      padding: 26px 26px 28px;
    }
    .cuerpo h3 {
      font-size: 22px;
    }
    .cuerpo ul {
      gap: 8px;
      margin-top: 6px;
    }
    .cuerpo p,
    .cuerpo li {
      line-height: 1.55;
    }
    .cuerpo li {
      padding: 4px 12px;
    }
    /* Centrada: deja el espacio del carril del cubo también a la izquierda */
    .interior {
      padding-left: 164px;
    }
    .tarjetas {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      margin-top: 72px;
    }
    .tarjeta {
      grid-column: span 2;
    }
    .tarjeta.grande {
      grid-column: span 3;
    }
    .arte {
      height: 180px;
    }
    .grande .arte {
      height: 220px;
    }
    .arte :global(.asoma) {
      width: 118px;
      bottom: -52px;
    }
  }

  /* ---------- Movimiento ---------- */
  /* Las tarjetas entran inclinadas hacia atrás y se enderezan; las de la derecha, un poco después */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tarjeta {
        animation: tarjeta-entra linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
      .tarjeta:nth-child(2),
      .tarjeta:nth-child(4) {
        animation-range: entry 10% entry 80%;
      }
      .tarjeta:nth-child(5) {
        animation-range: entry 20% entry 90%;
      }
    }
  }

  /* Alternativa con IntersectionObserver (Firefox) */
  :global(.io) .tarjeta {
    opacity: 0;
    transform: translateY(90px) rotateX(38deg) scale(0.92);
    transition:
      opacity 0.9s var(--ease-kairo),
      transform 0.9s var(--ease-kairo),
      border-color 0.3s,
      translate 0.4s var(--ease-kairo);
  }
  :global(.io) .tarjeta:nth-child(2),
  :global(.io) .tarjeta:nth-child(4) {
    transition-delay: 0.1s, 0.1s, 0s, 0s;
  }
  :global(.io) .tarjeta:nth-child(5) {
    transition-delay: 0.2s, 0.2s, 0s, 0s;
  }
  :global(.io) .tarjeta:global(.visible) {
    opacity: 1;
    transform: none;
  }

  @keyframes tarjeta-entra {
    from { opacity: 0; transform: translateY(90px) rotateX(38deg) scale(0.92); }
    to { opacity: 1; transform: none; }
  }
</style>
