{
  // Configuración de Cloudflare Workers. El sitio es 100 % estático: no hay código de Worker,
  // Cloudflare sirve directamente los archivos que genera «astro build» en ./dist.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kiro",
  "compatibility_date": "2026-10-22",
  // La dirección antigua (https://kiro.kirosolutionsco.workers.dev) sigue funcionando para no romper
  // enlaces ya compartidos; su canonical apunta a kairosolutions.dev.
  "workers_dev": true,
  // Sin URL extra por versión: solo existe la dirección principal del sitio
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Cualquier ruta que no exista responde con dist/404.html (src/pages/404.astro) y código 404.
    "not_found_handling": "404-page"
  },
  // Dominio propio (Cloudflare Registrar). «custom_domain» hace que wrangler cree el registro DNS y el
  // certificado HTTPS. www sirve la misma página; el canonical le dice a Google que la principal es sin www.
  "routes": [
    { "pattern": "kairosolutions.dev", "custom_domain": true },
    { "pattern": "www.kairosolutions.dev", "custom_domain": true }
  ]
}
