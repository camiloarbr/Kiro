    84%, 100% { transform: rotateX(-24deg) rotateY(-35deg) scale3d(1, 1, 1); }
  }
  /*
    36–64 %: en computador la cámara gira poco (rotateY -10deg y no -24deg) para que los 3 mini cubos,
