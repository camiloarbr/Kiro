---
// Franja corta que suaviza el paso de una sección clara a una oscura con un degradado fijo,
// igual en computador y en celular. Sus bordes coinciden con las secciones vecinas, así que no hay corte.
interface Props {
  desde: string;
  hacia: string;
  /** Alto de la franja en px (el mismo en todos los tamaños de pantalla) */
  alto: number;
}

const { desde, hacia, alto } = Astro.props;
---

<div class="transicion" aria-hidden="true" style={`--desde: ${desde}; --hacia: ${hacia}; height: ${alto}px;`}></div>

<style>
  /*
    Paradas repartidas para que la luminosidad baje pareja (sin un tramo que se oscurezca de golpe),
    pasando por los morados de la marca. «in oklab» evita el gris sucio a mitad del degradado.
  */
  .transicion {
    background: linear-gradient(
      180deg in oklab,
      var(--desde) 0%,
      color-mix(in oklab, var(--desde), var(--color-lav-media)) 14%,
      var(--color-lav-media) 28%,
      color-mix(in oklab, var(--color-lav-media), var(--color-profundo-1)) 46%,
      var(--color-profundo-1) 64%,
      color-mix(in oklab, var(--color-profundo-1), var(--hacia)) 82%,
      var(--hacia) 100%
    );
  }
</style>
