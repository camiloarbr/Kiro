---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CuboViajero from '../components/CuboViajero.astro';
import TuDia from '../components/TuDia.astro';
import Servicios from '../components/Servicios.astro';
import Footer from '../components/Footer.astro';

// PROVISIONAL: secciones de relleno con los id reales; cada una se reemplaza en los pasos 7 y 8.
const relleno = [
  { id: 'demo', nombre: 'Demo de Kiro Bot', paso: 7 },
  { id: 'como', nombre: 'Cómo trabajamos', paso: 8 },
  { id: 'contacto', nombre: 'Contacto', paso: 8 },
];
---

<BaseLayout>
  <Header />
  <main class="recorrido">
    <CuboViajero />
    <Hero />
    <div class="flujo">
      <TuDia />
      <Servicios />
      {
        relleno.map((s, i) => (
          <section id={s.id} class:list={['flex min-h-[560px] items-center', i % 2 ? 'bg-lav' : 'bg-lav-2']}>
            <div class="contenedor w-full">
              <p class="eyebrow">Paso {s.paso}</p>
              <h2 class="titulo mt-4 text-[clamp(34px,4vw,56px)]">{s.nombre}</h2>
            </div>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /*
    .recorrido es el «escenario» del cubo:
    - container-type permite medir en cqw (ancho de este contenedor) para ubicar el carril.
    - timeline-scope sube las líneas de tiempo --hero (portada) y --flujo (secciones)
      hasta aquí, para que el cubo, que es hermano de ellas, pueda usarlas.
  */
  .recorrido {
    position: relative;
    container-type: inline-size;
    timeline-scope: --hero, --flujo;
  }
  .flujo {
    position: relative;
    view-timeline: --flujo block;
  }
</style>
