---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CuboViajero from '../components/CuboViajero.astro';
import TuDia from '../components/TuDia.astro';
import Servicios from '../components/Servicios.astro';
import DemoKai from '../components/DemoKai.astro';
import ComoTrabajamos from '../components/ComoTrabajamos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Transicion from '../components/Transicion.astro';
import Acompanante from '../components/Acompanante.astro';
---

<BaseLayout>
  <Header />
  <main class="recorrido">
    <CuboViajero />
    <Acompanante />
    <Hero />
    <div class="flujo">
      <TuDia />
      <Transicion desde="var(--color-lav)" hacia="var(--color-negro)" alto={160} />
      <Servicios />
      <DemoKai />
      <ComoTrabajamos />
      <Contacto />
    </div>
  </main>
  <Transicion desde="var(--color-lav)" hacia="var(--color-negro)" alto={72} />
  <Footer />
</BaseLayout>

<style>
  /*
    .recorrido es el «escenario» del cubo:
    - container-type permite medir en cqw (ancho de este contenedor) para ubicar el carril.
    - timeline-scope sube las líneas de tiempo --hero (portada), --flujo (secciones) y --dia («Tu día»)
      hasta aquí, para que el cubo y el acompañante, que son hermanos de ellas, puedan usarlas.
  */
  .recorrido {
    position: relative;
    container-type: inline-size;
    timeline-scope: --hero, --flujo, --dia;
    /* Cuánto sube «Tu día» sobre el final de la portada (lo usan TuDia y CuboViajero) */
    --solape: 240px;
  }
  @media (width >= 56.25rem) {
    .recorrido {
      --solape: 320px;
    }
  }
  .flujo {
    position: relative;
    view-timeline: --flujo block;
  }
</style>
