---
import { escenarios, ocupacion } from '../data/demo';

// Avatares de la tabla (nombres de muestra)
const personas = [
  { iniciales: 'LM', nombre: 'Laura M.', color: '#D9C4FF' },
  { iniciales: 'AP', nombre: 'Andrés P.', color: '#C8E3D4' },
  { iniciales: 'SR', nombre: 'Sofía R.', color: '#F2D9C2' },
];
---

<section id="demo" class="demo pt-24 pb-18 md:pt-[150px] md:pb-[110px]" aria-labelledby="demo-t">
  <div class="contenedor">
    <div class="cabeza">
      <span class="eyebrow revela items-center">Así se ve en tu negocio</span>
      <h2 id="demo-t" class="titulo revela max-w-[18ch] text-[clamp(34px,4vw,56px)] leading-[1.05]">
        Del mensaje a la reserva, sin que muevas un dedo.
      </h2>
      <p class="revela-2">Un cliente escribe, Kiro Bot responde y la reserva aparece confirmada en tu panel.</p>
      <div class="selector" role="group" aria-label="Ver el ejemplo de">
        {
          escenarios.map((e, i) => (
            <button type="button" class="seg" data-ver={e.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {e.boton}
            </button>
          ))
        }
      </div>
    </div>

    <div class="escena3d" data-io>
      {
        escenarios.map((e, i) => (
          <div class="escenario" data-escenario={e.id} hidden={i !== 0}>
            <div class="tablero" role="img" aria-label={e.etiquetaAccesible}>
              <div class="camara" aria-hidden="true">
                {/* Acto 2: el celular con la conversación */}
                <div class="c">
                  <div class="celular">
                    <div class="cel-cuerpo">
                      <div class="pantalla">
                        <div class="cel-cabeza">
                          <span class="cel-avatar">K</span>
                          <div class="flex flex-col gap-px">
                            <span class="text-[15px] font-semibold">Kiro Bot</span>
                            <span class="text-xs text-violeta-claro">en línea</span>
                          </div>
                        </div>
                        <div class="mensajes">
                          <div class="msg cliente m1">{e.cliente1}</div>
                          {/* Los puntos «escribiendo…» ocupan el lugar de la respuesta que viene */}
                          <div class="hueco">
                            <div class="puntos p1"><span /><span /><span /></div>
                            <div class="msg bot m2">{e.bot1}</div>
                          </div>
                          <div class="msg cliente m3">{e.cliente2}</div>
                          <div class="hueco">
                            <div class="puntos p2"><span /><span /><span /></div>
                            <div class="msg bot m4">{e.bot2}</div>
                          </div>
                        </div>
                        <div class="cel-entrada">Escribe un mensaje<span /></div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Acto 1: la barra donde el cliente escribe */}
                <div class="c">
                  <div class="barra">
                    <div class="campo">
                      <span class="tecleo" style={`--letras: ${[...e.cliente1].length}`}>
                        {e.cliente1}
                        <span class="cortina" />
                      </span>
                    </div>
                    <div class="enviar">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
                    </div>
                  </div>
                </div>

                {/* Acto 3: el panel del negocio */}
                <div class="c">
                  <div class="panel">
                    <div class="ventana">
                      <div class="lateral">
                        <div class="marca">
                          <span class="marca-ini">{e.inicialMarca}</span>
                          <span class="text-xs font-semibold whitespace-nowrap">{e.marca}</span>
                        </div>
                        <div class="nav activo">
                          <span>{e.menu[0]}</span>
                          <span class="contador">1</span>
                        </div>
                        {e.menu.slice(1).map((m) => (
                          <div class="nav"><span>{m}</span></div>
                        ))}
                        <div class="bot-activo"><span class="bot-ini">K</span>Kiro Bot activo</div>
                      </div>

                      <div class="principal">
                        <div class="flex items-start justify-between">
                          <div class="flex flex-col gap-[3px]">
                            <span class="font-display text-[17px] font-bold">{e.titulo}</span>
                            <span class="text-[11px] text-texto-oscuro-2">{e.semana}</span>
                          </div>
                          <span class="accion">{e.accion}</span>
                        </div>

                        <div class="kpis">
                          <div class="kpi">
                            <span class="kl">{e.kpi1}</span>
                            <span class="kv"><span class="antes">7 de 8</span><span class="despues">8 de 8</span></span>
                          </div>
                          <div class="kpi">
                            <span class="kl">Por confirmar</span>
                            <span class="kv"><span class="antes">1</span><span class="despues">0</span></span>
                          </div>
                          <div class="kpi">
                            <span class="kl">{e.kpi3}</span>
                            <span class="kv"><span>{e.kpi3Valor}</span></span>
                          </div>
                        </div>

                        <div class="grilla">
                          <span />
                          {e.columnas.map((col) => <span class="gh">{col}</span>)}
                          {ocupacion.map((fila, r) => (
                            <>
                              <span class="gl">{e.filas[r]}</span>
                              {fila.map((v) => (
                                <span class:list={['celda', { ocupada: v === 1, nueva: v === 2 }]} />
                              ))}
                            </>
                          ))}
                        </div>

                        <div class="tabla">
                          <div class="tfila th"><span>{e.columnaA}</span><span>Detalle</span><span>Estado</span></div>
                          {personas.map((p, j) => (
                            <div class:list={['tfila', { nueva: j === 0 }]}>
                              <span class="quien"><span class="av" style={`background: ${p.color}`}>{p.iniciales}</span>{p.nombre}</span>
                              <span>{e.detalle[j]}</span>
                              {j === 0 ? (
                                <span class="estado"><span class="pen antes">Por confirmar</span><span class="ok despues">Confirmada</span></span>
                              ) : (
                                <span class="etiq">{j === 1 ? 'Confirmada' : 'Pagada'}</span>
                              )}
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>

                    <div class="aviso">
                      <span class="aviso-ok"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg></span>
                      {e.aviso}
                    </div>
                  </div>
                </div>

                {/* La reserva que vuela del celular al panel */}
                <div class="c">
                  <div class="vuelo"><span class="vuelo-ico" />{e.vuelo}</div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Selector Hotel / Consultorio: muestra un escenario y oculta el otro.
  // Al volver a mostrarse (de hidden a visible), sus animaciones CSS arrancan desde cero.
  const botones = document.querySelectorAll<HTMLButtonElement>('.demo .seg');
  const escenas = document.querySelectorAll<HTMLElement>('.demo .escenario');

  for (const boton of botones) {
    boton.addEventListener('click', () => {
      const elegido = boton.dataset.ver;
      for (const b of botones) b.setAttribute('aria-pressed', String(b === boton));
      for (const escena of escenas) escena.hidden = escena.dataset.escenario !== elegido;
    });
  }
</script>

<style>
  .demo {
    color: var(--color-white);
    background: linear-gradient(180deg, var(--color-negro) 0%, var(--color-profundo-1) 35%, var(--color-profundo-2) 65%, var(--color-profundo-3) 100%);
  }
  .cabeza {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .cabeza .eyebrow {
    color: #f3eaff;
  }
  .cabeza p {
    margin: 0;
    max-width: 48ch;
    color: #f3eaff;
  }

  /* ---------- Selector ---------- */
  .selector {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }
  .seg {
    min-height: 44px;
    padding: 0 22px;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    color: var(--color-white);
    font: 600 16px var(--font-sans);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .seg:hover {
    background: rgb(255 255 255 / 0.24);
  }
  .seg[aria-pressed='true'] {
    background: var(--color-white);
    color: var(--color-violeta-oscuro);
  }

  /* ---------- Escena ---------- */
  .escena3d {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 640px;
    margin-top: 24px;
  }
  .escenario {
    width: 100%;
    max-width: 600px;
  }
  .escenario[hidden] {
    display: none;
  }
  /* El escenario: perspectiva de cámara y todo lo de adentro vive en 3D */
  .tablero {
    position: relative;
    width: 100%;
    max-width: 600px;
    height: 620px;
    margin: 0 auto;
    perspective: 1300px;
    perspective-origin: 50% 45%;
    -webkit-font-smoothing: antialiased;
  }
  .camara {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  /* Cada pieza se centra en el escenario con left/top 50 % y márgenes negativos */
  .c {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
  }

  /* Acto 1: barra de chat */
  .barra {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 342px;
    margin: -22px 0 0 -171px;
    transform-origin: 50% 50%;
  }
  .campo {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 12px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: 22px;
    background: var(--color-blanco);
  }
  .tecleo {
    position: relative;
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    font-size: 12.5px;
    color: var(--color-grafito);
  }
  /* «Cortina» del color del campo con el cursor violeta: al correrse a la derecha a saltos
     (steps), va destapando el texto como si se escribiera letra por letra */
  .cortina {
    position: absolute;
    inset: 0;
    background: var(--color-blanco);
    border-left: 2px solid var(--color-violeta);
  }
  .enviar {
    flex: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-violeta);
  }

  /* Acto 2: celular */
  .celular {
    width: 260px;
    height: 540px;
    margin: -270px 0 0 -130px;
    transform-style: preserve-3d;
  }
  .cel-cuerpo {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 10px;
    border-radius: 42px;
    background: #0f0c14;
    box-shadow: 0 40px 80px rgb(0 0 0 / 0.5);
  }
  .pantalla {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 33px;
    background: var(--color-blanco);
  }
  .cel-cabeza {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 30px 16px 14px;
    background: var(--color-negro);
    color: var(--color-white);
  }
  .cel-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-violeta);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
  }
  .mensajes {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 12px;
  }
  .msg {
    max-width: 86%;
    padding: 10px 13px;
    font-size: 15px;
    line-height: 1.35;
  }
  .cliente {
    align-self: flex-end;
    background: var(--color-white);
    color: var(--color-grafito);
    border-radius: 16px 16px 4px 16px;
  }
  .bot {
    background: var(--color-violeta);
    color: var(--color-white);
    border-radius: 16px 16px 16px 4px;
  }
  .hueco {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .puntos {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    gap: 5px;
    padding: 12px 14px;
    border-radius: 16px;
    background: #e7e2ee;
    opacity: 0;
  }
  .puntos span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8e86a0;
  }
  .cel-entrada {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42px;
    margin: 0 10px 12px;
    padding: 0 6px 0 16px;
    border-radius: 21px;
    background: var(--color-white);
    font-size: 13px;
    color: #6f6780;
  }
  .cel-entrada span {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-violeta);
  }

  /* La reserva que vuela */
  .vuelo {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 230px;
    margin: -26px 0 0 -115px;
    padding: 10px 14px;
    box-sizing: border-box;
    border-radius: 12px;
    background: var(--color-white);
    color: var(--color-grafito);
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 24px 50px rgb(0 0 0 / 0.45);
  }
  .vuelo-ico {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--color-violeta);
  }

  /* Acto 3: panel */
  .panel {
    position: relative;
    width: 350px;
    margin: -225px 0 0 -175px;
    transform-style: preserve-3d;
  }
  .ventana {
    display: flex;
    overflow: hidden;
    border-radius: 14px;
    background: #14111a;
    box-shadow: 0 50px 90px rgb(0 0 0 / 0.5);
    color: var(--color-blanco);
    font-size: 12px;
  }
  .lateral {
    display: none;
    flex: none;
    flex-direction: column;
    gap: 3px;
    width: 138px;
    box-sizing: border-box;
    padding: 14px 10px;
    background: #0f0c14;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 6px 14px;
  }
  .marca-ini {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--color-blanco);
    color: var(--color-negro);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 8px;
    border-radius: 7px;
    color: var(--color-texto-oscuro-2);
  }
  .nav.activo {
    background: #221d2b;
    color: var(--color-white);
  }
  .contador {
    padding: 0 6px;
    border-radius: 8px;
    background: var(--color-violeta);
    color: var(--color-white);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
  }
  .bot-activo {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding: 6px 8px;
    color: var(--color-texto-oscuro-2);
    font-size: 11px;
  }
  .bot-ini {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-violeta);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
  }
  .principal {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 14px;
  }
  .accion {
    padding: 6px 10px;
    border-radius: 7px;
    background: var(--color-blanco);
    color: var(--color-negro);
    font-weight: 600;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .kpi {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 9px 11px;
    border-radius: 9px;
    background: #1b1723;
  }
  .kl {
    font-size: 10px;
    color: var(--color-texto-oscuro-2);
  }
  /* «antes» y «despues» se superponen en el mismo lugar y se cruzan con opacity */
  .kv {
    position: relative;
    height: 20px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
  }
  .kv span {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }
  .grilla {
    display: grid;
    grid-template-columns: 34px repeat(8, minmax(0, 1fr));
    gap: 4px;
    align-items: center;
  }
  .gl {
    font-size: 11px;
    color: var(--color-texto-oscuro-2);
  }
  .gh {
    font-size: 10px;
    text-align: center;
    white-space: nowrap;
    color: #9a92ad;
  }
  .celda {
    position: relative;
    height: 16px;
    border-radius: 4px;
    background: #221d2b;
  }
  .celda.ocupada {
    background: #4a3a63;
  }
  /* La celda nueva: dos capas encima (lila y violeta) que se encienden con opacity */
  .celda.nueva::before,
  .celda.nueva::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
  }
  .celda.nueva::before {
    background: var(--color-violeta-claro);
  }
  .celda.nueva::after {
    background: var(--color-violeta);
  }
  .tabla {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tfila {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.2fr) auto;
    gap: 6px;
    align-items: center;
    padding: 7px 6px;
    border-radius: 7px;
    font-size: 11px;
    color: var(--color-texto-oscuro);
  }
  .tfila.th {
    padding-top: 0;
    padding-bottom: 2px;
    color: #9a92ad;
  }
  /* Resaltado de la fila nueva: capa detrás (z-index -1 dentro de su isolation) */
  .tfila.nueva::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #2e1b4d;
    opacity: 0;
  }
  .quien {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--color-white);
    font-weight: 500;
    white-space: nowrap;
  }
  .av {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: var(--color-negro);
    font-size: 9px;
    font-weight: 700;
  }
  .estado {
    position: relative;
    width: 86px;
    height: 20px;
  }
  .estado span,
  .etiq {
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }
  .estado span {
    position: absolute;
    left: 0;
    top: 0;
  }
  .pen {
    background: #3a2f4a;
    color: #e7e2ee;
  }
  .ok {
    background: var(--color-violeta);
    color: var(--color-white);
  }
  .etiq {
    justify-self: start;
    background: #221d2b;
    color: var(--color-texto-oscuro);
  }
  .aviso {
    position: absolute;
    right: 8px;
    bottom: -30px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--color-blanco);
    color: var(--color-negro);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 24px 50px rgb(0 0 0 / 0.45);
  }
  .aviso-ok {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-violeta);
  }

  /* ---------- Computador: piezas a tamaño completo y panel con barra lateral ---------- */
  @media (width >= 56.25rem) {
    .escena3d {
      height: 620px;
    }
    .barra {
      width: 480px;
      margin: -32px 0 0 -240px;
      gap: 12px;
    }
    .campo {
      height: 64px;
      padding: 0 24px;
      border-radius: 32px;
    }
    .tecleo {
      font-size: 17px;
    }
    .enviar {
      width: 64px;
      height: 64px;
    }
    .panel {
      width: 560px;
      margin: -200px 0 0 -280px;
    }
    .ventana {
      height: 400px;
    }
    .lateral {
      display: flex;
    }
    .principal {
      padding: 16px 18px;
    }
    .kl {
      font-size: 11px;
    }
    .tfila {
      grid-template-columns: 1.3fr 1.4fr 1fr;
      gap: 8px;
      padding: 7px 8px;
      font-size: 12px;
    }
    .estado {
      width: auto;
    }
    .aviso {
      right: -22px;
      bottom: -26px;
      padding: 12px 16px;
      font-size: 14px;
    }
  }

  /* =========================================================================
