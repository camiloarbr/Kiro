---
// Olas de vidrio violeta a los lados de Servicios. El SVG es el mismo para ambos lados:
// la derecha se refleja con scaleX(-1). Cada lado necesita sus propios id de degradado.
const lados = ['izq', 'der'] as const;
---

<div class="olas" aria-hidden="true">
  {
    lados.map((lado) => (
      <div class={`lado ${lado}`}>
        <svg class="ola" viewBox="0 0 420 960" preserveAspectRatio="none">
          <defs>
            <linearGradient id={`ola-frente-${lado}`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#2A1450" />
              <stop offset=".45" stop-color="#14091F" />
              <stop offset=".75" stop-color="#3A1677" />
              <stop offset="1" stop-color="#0C0A10" />
            </linearGradient>
            <linearGradient id={`ola-fondo-${lado}`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#1B0F2E" />
              <stop offset=".5" stop-color="#5B17B8" />
              <stop offset="1" stop-color="#120A1E" />
            </linearGradient>
            <linearGradient id={`ola-borde-${lado}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8B2CF5" stop-opacity=".2" />
              <stop offset=".35" stop-color="#D9C4FF" />
              <stop offset=".6" stop-color="#B07CFF" />
              <stop offset="1" stop-color="#8B2CF5" stop-opacity=".1" />
            </linearGradient>
          </defs>
          <path fill={`url(#ola-fondo-${lado})`} opacity=".9" d="M-30,-20 C170,140 -10,400 160,600 S220,880 140,980 L-160,980 L-160,-20 Z" />
          <path fill={`url(#ola-frente-${lado})`} d="M-30,-20 C250,140 40,400 250,600 S320,880 140,980 L-160,980 L-160,-20 Z" />
          <path fill="none" stroke={`url(#ola-borde-${lado})`} stroke-width="2.5" d="M-30,-20 C250,140 40,400 250,600 S320,880 140,980" />
          <path fill="none" stroke={`url(#ola-borde-${lado})`} stroke-width="1.5" opacity=".6" d="M-30,-20 C170,140 -10,400 160,600 S220,880 140,980" />
        </svg>
      </div>
    ))
  }
</div>

<style>
  .olas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Desvanecidas arriba y abajo: la sección las recorta (overflow: hidden) y sin esto se veía
       un corte recto al entrar desde «Tu día» y al pasar al demo */
    mask-image: linear-gradient(180deg, transparent 0, #000 220px, #000 calc(100% - 260px), transparent 100%);
  }

  /*
    Dos movimientos que se suman, en dos elementos distintos:
    - .lado (contenedor): parallax con el scroll, usando translate/rotate.
    - .ola (el SVG): vaivén continuo por tiempo, usando transform.
    Si los dos estuvieran en el mismo elemento, una animación pisaría a la otra.
  */
  .lado {
    position: absolute;
    top: -4%;
    height: 108%;
    width: 46vw;
    opacity: 0.75;
    will-change: transform;
  }
  .izq {
    left: -22vw;
  }
  .der {
    right: -22vw;
    transform: scaleX(-1);
  }
  .ola {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 0 50%;
    will-change: transform;
  }

  @media (width >= 56.25rem) {
    .lado {
      width: min(24vw, 360px);
      opacity: 1;
    }
    .izq {
      left: -40px;
    }
    .der {
      right: -40px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ola {
      animation: vaiven 9s ease-in-out infinite alternate;
    }
    .der .ola {
      animation-duration: 11s;
      animation-delay: -4s;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .izq {
        animation: parallax-izq linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
      .der {
        animation: parallax-der linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  /* translate y rotate son propiedades independientes de transform: no borran el scaleX(-1) */
  @keyframes parallax-izq {
    from { translate: -60px 80px; rotate: -4deg; }
    to { translate: 0 -80px; rotate: 3deg; }
  }
  @keyframes parallax-der {
    from { translate: 60px -60px; rotate: 4deg; }
    to { translate: 0 80px; rotate: -3deg; }
  }
  @keyframes vaiven {
    0% { transform: scaleX(1) skewY(0deg) translateY(0); }
    50% { transform: scaleX(1.08) skewY(-3deg) translateY(-20px); }
    100% { transform: scaleX(0.9) skewY(2deg) translateY(16px); }
  }
</style>
