---
// Cubo de vidrio que acompaña la página desde el final de la portada hasta el contacto.
// Es decorativo: aria-hidden y sin eventos de mouse.
---

<div class="riel" aria-hidden="true">
  <div class="viajero">
    <div class="cubo"><i></i><i></i><i></i><i></i><i></i><i></i><b></b></div>
  </div>
</div>

<style>
  /* Sin scroll-driven animations o con «reducir movimiento» el cubo no se muestra. */
  .riel {
    display: none;
  }

  @supports (animation-timeline: view()) and (timeline-scope: none) {
    @media (prefers-reduced-motion: no-preference) {
      /*
        El riel ocupa todo el alto de .recorrido (portada + secciones), a la derecha.
        Dentro, .viajero es sticky: se queda centrado en la pantalla mientras el riel pasa.
      */
      .riel {
        display: block;
        position: absolute;
        top: 0;
        bottom: 0;
        right: max(20px, calc(50cqw - 680px));
        width: 120px;
        z-index: 6;
        pointer-events: none;
      }

      /* Línea violeta: empieza donde termina la portada y se «dibuja» con el scroll */
      .riel::before {
        content: '';
        position: absolute;
        left: 59px;
        top: 2600px;
        width: 2px;
        height: calc(100% - 2600px);
        background: linear-gradient(
          180deg,
          rgb(139 44 245 / 0),
          rgb(139 44 245 / 0.35) 8%,
          rgb(176 124 255 / 0.35) 92%,
          rgb(139 44 245 / 0)
        );
        transform-origin: top;
        animation: trazo linear both;
        animation-timeline: --flujo;
        animation-range: entry 0% exit 100%;
      }

      /*
        Aparece al 92–100 % de la portada, justo cuando los paneles se arman en este
        mismo punto. --hero vive en la portada, que no es antepasado del riel: por eso
        .recorrido declara timeline-scope, para que la línea de tiempo se vea desde aquí.
      */
      .viajero {
        position: sticky;
        top: calc(50vh - 60px);
        width: 120px;
        height: 120px;
        perspective: 700px;
        animation: aparece linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      .viajero::before {
        content: '';
        position: absolute;
        inset: -30px;
        border-radius: 50%;
        background: radial-gradient(closest-side, rgb(139 44 245 / 0.45), rgb(139 44 245 / 0));
      }

      /* El cubo: 6 caras <i> colocadas en 3D con preserve-3d; gira ~3 vueltas en el recorrido */
      .cubo {
        position: absolute;
        left: 25px;
        top: 25px;
        width: 70px;
        height: 70px;
        --mitad: 35px;
        transform-style: preserve-3d;
        will-change: transform;
        animation: giro linear both;
        animation-timeline: --flujo;
        animation-range: entry 0% exit 100%;
      }
      .cubo i {
        position: absolute;
        inset: 0;
        border: 1.5px solid rgb(233 220 255 / 0.8);
        background: linear-gradient(150deg, rgb(176 124 255 / 0.82), rgb(110 34 214 / 0.7));
        border-radius: 10px;
        box-shadow: inset 0 0 18px rgb(217 196 255 / 0.5);
      }
      /* Cada cara se gira hacia su lado y se empuja media arista hacia afuera */
      .cubo i:nth-child(1) { transform: translateZ(var(--mitad)); }
      .cubo i:nth-child(2) { transform: rotateY(180deg) translateZ(var(--mitad)); }
      .cubo i:nth-child(3) { transform: rotateY(90deg) translateZ(var(--mitad)); }
      .cubo i:nth-child(4) { transform: rotateY(-90deg) translateZ(var(--mitad)); }
      .cubo i:nth-child(5) { transform: rotateX(90deg) translateZ(var(--mitad)); }
      .cubo i:nth-child(6) { transform: rotateX(-90deg) translateZ(var(--mitad)); }

      /*
        Núcleo de luz que late. La referencia animaba box-shadow (repinta cada cuadro);
        aquí la sombra es fija y el «latido» es scale + un halo extra que sube su opacity.
      */
      .cubo b {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 18px;
        height: 18px;
        margin: -9px 0 0 -9px;
        background: var(--color-white);
        border-radius: 4px;
        box-shadow: 0 0 24px 8px rgb(176 124 255 / 0.9);
        animation: latido 2.4s ease-in-out infinite;
      }
      .cubo b::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: 0 0 36px 14px rgb(176 124 255 / 1);
        opacity: 0;
        animation: halo 2.4s ease-in-out infinite;
      }
    }

    @media (prefers-reduced-motion: no-preference) and (width < 56.25rem) {
      .riel {
        right: -4px;
        width: 64px;
      }
      .riel::before {
        left: 31px;
        top: 2300px;
        height: calc(100% - 2300px);
        opacity: 0.6;
      }
      .viajero {
        top: calc(100vh - 150px);
        width: 64px;
        height: 64px;
        perspective: 500px;
      }
      .viajero::before {
        inset: -14px;
      }
      .cubo {
        left: 16px;
        top: 16px;
        width: 32px;
        height: 32px;
        --mitad: 16px;
      }
      .cubo i {
        border-radius: 6px;
      }
      .cubo b {
        width: 10px;
        height: 10px;
        margin: -5px 0 0 -5px;
      }
    }
  }

  @keyframes trazo {
    from { scale: 1 0; }
    to { scale: 1 1; }
  }
  @keyframes aparece {
    0%, 92% { opacity: 0; scale: 1; }
    95% { opacity: 1; scale: 1.25; }
    100% { opacity: 1; scale: 1; }
  }
  /* Empieza en la misma pose en que quedan armados los paneles: rotateX(-24deg) rotateY(-35deg) */
  @keyframes giro {
    0% { transform: rotateX(-24deg) rotateY(-35deg) rotateZ(0deg); }
    25% { transform: rotateX(70deg) rotateY(235deg) rotateZ(20deg); }
    50% { transform: rotateX(-30deg) rotateY(505deg) rotateZ(-20deg); }
    75% { transform: rotateX(120deg) rotateY(775deg) rotateZ(15deg); }
    100% { transform: rotateX(-24deg) rotateY(1045deg) rotateZ(0deg); }
  }
  @keyframes latido {
    50% { transform: scale(1.5); }
  }
  @keyframes halo {
    50% { opacity: 1; }
  }
</style>
