    scale3d y no scale: scale() solo agranda x e y, y el cubo quedaba aplastado en profundidad.
  */
  @keyframes portada-camara {
    0%, 6% { transform: rotateX(-24deg) rotateY(-35deg) scale3d(var(--s0), var(--s0), var(--s0)); }
    20% { transform: rotateX(-14deg) rotateY(-70deg) scale3d(1, 1, 1); }
