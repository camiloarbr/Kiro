---
// Kai en vivo (3D). Primero se ve el póster: una imagen del mismo Kai 3D, quieto y con la misma cámara.
// Después de cargar la página, src/scripts/kai/iniciar.ts trae three.js y el modelo, y un solo <canvas>
// pasa por los lugares marcados con data-kai (portada → acompañante → contacto) según cuál se vea.
// Sin WebGL, con «ahorro de datos» o si algo falla, queda el póster: la página se ve igual, solo que quieta.
import { vistaDe } from '../scripts/kai/forma';

interface Props {
  /** Lugar en la página: decide la prioridad cuando dos se ven a la vez. */
  lugar: 'portada' | 'acompanante' | 'contacto';
  /** Ancho aproximado en pantalla (px), para elegir el tamaño del póster. El ancho real va por CSS (--kai-lado). */
  ancho: number;
  /** Texto alternativo. Vacío = decorativo. */
  alt?: string;
  /** true solo en la primera pantalla (carga sin esperar al scroll). */
  prioridad?: boolean;
  /** Atributo sizes del póster cuando el tamaño cambia según la pantalla (si no, se usa `ancho`). */
  tamanos?: string;
}

const { lugar, ancho, alt = '', prioridad = false, tamanos } = Astro.props;
// El póster usa la misma vista que el 3D en ese lugar. En la portada Kai va más grande (hasta ~550 px en
// pantalla), así que sus pósters llegan a 1080 px para verse nítidos en pantallas de alta densidad
const portada = vistaDe(lugar) === 'portada';
const poster = portada ? '/kai/kai-3d-portada' : '/kai/kai-3d';
const anchos = portada ? [270, 540, 810, 1080] : [180, 360, 540];
---

<div class="kai-vivo" data-kai={lugar}>
  <img
    class="kai-poster"
    src={`${poster}-${anchos[1]}.webp`}
    srcset={anchos.map((a) => `${poster}-${a}.webp ${a}w`).join(', ')}
    sizes={tamanos ?? `${ancho}px`}
    width={ancho}
    height={ancho}
    alt={alt}
    loading={prioridad ? 'eager' : 'lazy'}
    decoding="async"
    draggable="false"
  />
</div>

<script>
  import '../scripts/kai/iniciar';
</script>

<style>
  /* Cuadrado: el encuadre de la cámara deja los pies al 89,9 % del alto (src/scripts/kai/forma.ts) */
  .kai-vivo {
    position: relative;
    width: var(--kai-lado, 120px);
    aspect-ratio: 1;
    pointer-events: none;
  }
  .kai-poster,
  .kai-vivo :global(.kai-canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    user-select: none;
  }
  .kai-poster {
    transition: opacity 0.4s;
  }
  /* El canvas no recibe clics: los botones y enlaces de alrededor siguen funcionando igual */
  .kai-vivo :global(.kai-canvas) {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .kai-en-vivo :global(.kai-canvas) {
    opacity: 1;
  }
  .kai-en-vivo .kai-poster {
    opacity: 0;
  }
</style>
